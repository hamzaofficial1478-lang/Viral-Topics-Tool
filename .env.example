# ShortForge API keys — copy this file to ".env" and fill in your own keys.
#
#   cp .env.example .env
#   # then edit .env
#
# ShortForge loads ./.env automatically on every run (see --env-file to point
# elsewhere). Real shell environment variables always take precedence, so an
# `export ANTHROPIC_API_KEY=...` in your shell overrides this file.
#
# ".env" is git-ignored — your keys stay on your machine and are never
# committed or sent anywhere except to the API you configured.
#
# EVERYTHING BELOW IS OPTIONAL. With no keys at all, ShortForge still runs fully
# offline: heuristic hook detection, offline Argos translation, espeak TTS.

# --- LLM provider (Part E) ---------------------------------------------------
# Enables smarter hook detection, higher-quality translation, and SEO metadata.
# Works with Anthropic directly OR any OpenAI-compatible gateway (many third-party
# providers serve Claude- and GPT-family models at their own base URL).
#
#   LLM_PROVIDER = anthropic | openai | none
#   LLM_BASE_URL = the gateway's base URL (find it in your provider's API docs;
#                  OpenAI-style usually ends in /v1). Leave blank for the vendor default.
#   LLM_API_KEY  = your key for that provider
#   LLM_MODEL    = the model id to use (e.g. claude-opus-4-8, gpt-4o-mini)
#
# Test it with:  python cli.py check-llm
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Back-compat: if you use Anthropic directly you can just set this instead of the
# LLM_* block above (ShortForge falls back to it automatically).
ANTHROPIC_API_KEY=

# --- TTS providers (Part L) --------------------------------------------------
# Priority-ordered list of provider NAMES. The router tries them left-to-right,
# skipping any that can't do what a call needs (language / SSML / emotion) and
# failing over on error. "edge" is the built-in Microsoft Edge neural voices
# (local, free, no SSML/emotion). Any other name maps to TTS_<NAME>_* below,
# spoken as the OpenAI TTS shape (POST {base}/audio/speech).
TTS_PROVIDERS=provider_a,provider_b,edge

# For each non-edge provider NAME, define a TTS_<NAME>_* block. Example for
# "provider_a" (rename to your provider). Declare its capabilities honestly —
# the router selects providers by these:
TTS_PROVIDER_A_BASE_URL=       # e.g. https://api.yourvoicevendor.com/v1
TTS_PROVIDER_A_API_KEY=
TTS_PROVIDER_A_MODEL=          # the vendor's TTS model id
TTS_PROVIDER_A_LANGS=          # comma list e.g. en,de,es,fr  (blank = any)
TTS_PROVIDER_A_SSML=false      # true if it accepts SSML input
TTS_PROVIDER_A_EMOTION=false   # true if it accepts a style/emotion parameter
TTS_PROVIDER_A_CLONE=false     # true if it can clone from a reference sample
TTS_PROVIDER_A_MAX_CHARS=4000  # per-request character limit
TTS_PROVIDER_A_COST_PER_1K=0   # USD per 1000 characters (for cost tracking)
# Per-language voice ids (uppercase ISO). Add the languages you dub into:
TTS_PROVIDER_A_VOICE_EN=
TTS_PROVIDER_A_VOICE_DE=
# TTS_PROVIDER_A_VOICE_ES=  ...

# (Optional) override built-in Edge voices per language:
# EDGE_VOICE_EN=en-US-AriaNeural

# --- Audio library (Part L / used by G2) -------------------------------------
# local = your own folder of owned/licensed music + SFX (safest for monetization);
# api   = a licensed royalty-free / generative-audio API you supply.
AUDIO_LIB_PROVIDER=local
AUDIO_LIB_PATH=                # folder of your owned tracks (add a library.json for licences)
AUDIO_LIB_BASE_URL=            # only for AUDIO_LIB_PROVIDER=api
AUDIO_LIB_API_KEY=

# Test everything with:  python cli.py check-providers
